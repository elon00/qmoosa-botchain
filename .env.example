# QMOOSA BOT CHAIN Environment Configuration
NODE_ENV=production
PORT=4021

# BOT Chain Network Parameters
BOTCHAIN_TESTNET_CHAIN_ID=968
BOTCHAIN_TESTNET_RPC=https://rpc.bohr.life
BOTCHAIN_TESTNET_EXPLORER=https://scan.bohr.life

BOTCHAIN_MAINNET_CHAIN_ID=677
BOTCHAIN_MAINNET_RPC=https://rpc.botchain.ai
BOTCHAIN_MAINNET_EXPLORER=https://scan.botchain.ai

# Security & Mainnet Spending Lock (MANDATORY)
MAINNET_LOCKED=true
REQUIRE_EXPLORER_EVIDENCE=true

# Tokenomics Contract Addresses (ERC-20 QBOT)
QBOT_TESTNET_TOKEN_ADDRESS=0x9680000000000000000000000000000000000402
QBOT_INITIAL_SUPPLY=1000000000
QBOT_ANNUAL_INFLATION_CEILING_PERCENT=2

# x402 Bazaar Protocol Configuration
X402_FACILITATOR_URL=https://facilitator.vativ.io
X402_SETTLEMENT_NETWORK=botchain-testnet
X402_PAYWALL_ENABLED=true

# AI Agentics Policy & Model Keys
AGENT_DAILY_BUDGET_QBOT=1.000
AGENT_PER_REQUEST_MAX_QBOT=0.010
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
